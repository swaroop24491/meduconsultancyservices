---
layout: null
sitemap_exclude: true
---
{%- comment -%}
  Generated sitemap: every published page except the 404 and noindex pages.
  hreflang pairs only where both languages exist. lastmod from front matter
  `last_modified` (rebuilt pages); pages not yet rebuilt have none.
{%- endcomment -%}
{%- assign base_url = site.data.site.url -%}
{%- assign entries = "" | split: "" -%}
{%- for p in site.html_pages -%}
  {%- unless p.noindex or p.sitemap_exclude or p.redirect_to or p.url contains "404" -%}
    {%- assign u = p.url | replace: "/index.html", "/" | remove: ".html" -%}
    {%- assign e = u | append: "#" | append: p.last_modified -%}
    {%- assign entries = entries | push: e -%}
  {%- endunless -%}
{%- endfor -%}
{%- for f in site.static_files -%}
  {%- if f.extname == ".html" -%}
    {%- unless f.path contains "404" -%}
      {%- assign u = f.path | replace: "/index.html", "/" | remove: ".html" -%}
      {%- assign entries = entries | push: u -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- assign all_urls = "|" -%}
{%- for e in entries -%}{%- assign u = e | split: "#" | first -%}{%- assign all_urls = all_urls | append: u | append: "|" -%}{%- endfor -%}
{%- assign entries = entries | sort -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for e in entries %}
{%- assign parts = e | split: "#" -%}
{%- assign u = parts[0] -%}
{%- assign lm = parts[1] -%}
{%- if u contains "/kn/" or u == "/kn" -%}
  {%- assign en_u = u | remove_first: "/kn" -%}{%- if en_u == "" %}{% assign en_u = "/" %}{% endif -%}
  {%- assign kn_u = u -%}
{%- else -%}
  {%- assign en_u = u -%}
  {%- assign kn_u = "/kn" | append: u -%}
{%- endif -%}
{%- assign en_key = "|" | append: en_u | append: "|" -%}
{%- assign kn_key = "|" | append: kn_u | append: "|" -%}
  <url>
    <loc>{{ base_url }}{{ u }}</loc>
{%- if lm and lm != "" %}
    <lastmod>{{ lm | date: "%Y-%m-%d" }}</lastmod>
{%- endif %}
{%- if all_urls contains en_key and all_urls contains kn_key %}
    <xhtml:link rel="alternate" hreflang="en" href="{{ base_url }}{{ en_u }}" />
    <xhtml:link rel="alternate" hreflang="kn" href="{{ base_url }}{{ kn_u }}" />
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ base_url }}{{ en_u }}" />
{%- endif %}
  </url>
{%- endfor %}
</urlset>
